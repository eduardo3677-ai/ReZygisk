type zygisk_file file_type
typeattribute zygisk_file mlstrustedobject
allow zygote zygisk_file sock_file {read write}

type rezygisk_log_file file_type
typeattribute rezygisk_log_file mlstrustedobject
# The log is pre-created by post-fs-data.sh, so zygote only needs to append to it.
allow zygote rezygisk_log_file dir search
allow zygote rezygisk_log_file file {append getattr open write}
allow magisk rezygisk_log_file dir search
allow magisk rezygisk_log_file file {append getattr open read unlink write}
allow ksu rezygisk_log_file dir search
allow ksu rezygisk_log_file file {append getattr open read unlink write}
allow apd rezygisk_log_file dir search
allow apd rezygisk_log_file file {append getattr open read unlink write}
allow su rezygisk_log_file dir search
allow su rezygisk_log_file file {append getattr open read unlink write}

allow zygote magisk lnk_file read
allow zygote unlabeled file {read open}
allow zygote zygote capability sys_chroot

# INFO: To allow to setns on the Zygote's child mns
allow zygote su dir search
allow zygote su {lnk_file file} read
# INFO: Same as above. KernelSU renamed su context to ksu
allow zygote ksu dir search
allow zygote ksu {lnk_file file} read
# INFO: APatch uses apd context
allow zygote apd dir search
allow zygote apd {lnk_file file} read

allow zygote adb_data_file dir search
allow zygote adb_data_file file *
allow zygote proc file {read open}
allow zygote nsfs file {read open}
allow zygote zygote process execmem
allow system_server system_server process execmem
allow zygote tmpfs file *
allow zygote appdomain_tmpfs file *

# INFO: Needed for Tango Zygote
allow zygote system_lib_file file execmod

# INFO: Needed for Android 14+ (API 34+) execmem restrictions
allow zygote zygote process {execmem execstack}
allow system_server system_server process {execmem execstack}
